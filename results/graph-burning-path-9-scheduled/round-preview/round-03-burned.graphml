<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d1" for="node" attr.name="source_round" attr.type="long" />
  <key id="d0" for="node" attr.name="first_burn_round" attr.type="long" />
  <graph edgedefault="undirected">
    <node id="1">
      <data key="d0">3</data>
      <data key="d1">0</data>
    </node>
    <node id="2">
      <data key="d0">2</data>
      <data key="d1">0</data>
    </node>
    <node id="3">
      <data key="d0">1</data>
      <data key="d1">1</data>
    </node>
    <node id="4">
      <data key="d0">2</data>
      <data key="d1">0</data>
    </node>
    <node id="5">
      <data key="d0">3</data>
      <data key="d1">0</data>
    </node>
    <node id="6">
      <data key="d0">3</data>
      <data key="d1">3</data>
    </node>
    <node id="7">
      <data key="d0">3</data>
      <data key="d1">0</data>
    </node>
    <node id="8">
      <data key="d0">2</data>
      <data key="d1">2</data>
    </node>
    <node id="9">
      <data key="d0">3</data>
      <data key="d1">0</data>
    </node>
    <edge source="1" target="2" />
    <edge source="2" target="3" />
    <edge source="3" target="4" />
    <edge source="4" target="5" />
    <edge source="5" target="6" />
    <edge source="6" target="7" />
    <edge source="7" target="8" />
    <edge source="8" target="9" />
  </graph>
</graphml>
