digraph ThirtyNodeGraph {
  graph [
    rankdir=LR,
    bgcolor="#ffffff",
    pad=0.3,
    nodesep=0.45,
    ranksep=1.0,
    splines=polyline,
    overlap=false,
    outputorder=edgesfirst,
    labelloc="t",
    fontsize=18,
    label="6 nodes | 6 edges | BFS source 1\nBlue = BFS tree | Gray = other edges\nweights shown"
  ];
  node [shape=circle, style=filled, fillcolor="#dbeafe", color="#1d4ed8", fontname="Arial", fontsize=10, width=0.75, height=0.75, fixedsize=true];
  edge [color="#9ca3af", arrowsize=0.55, penwidth=0.8];

  n1 [label="1\nd=0", fillcolor="#fbbf24", color="#92400e", penwidth=2.4, tooltip="Vertex 1; BFS distance 0; defined in graph.txt"];
  n2 [label="2\nd=1", fillcolor="#dbeafe", color="#1d4ed8", tooltip="Vertex 2; BFS distance 1; defined in graph.txt"];
  n3 [label="3\nd=1", fillcolor="#dbeafe", color="#1d4ed8", tooltip="Vertex 3; BFS distance 1; defined in graph.txt"];
  n4 [label="4\nd=2", fillcolor="#dbeafe", color="#1d4ed8", tooltip="Vertex 4; BFS distance 2; defined in graph.txt"];
  n5 [label="5\nd=3", fillcolor="#dbeafe", color="#1d4ed8", tooltip="Vertex 5; BFS distance 3; defined in graph.txt"];
  n6 [label="6\nd=2", fillcolor="#dbeafe", color="#1d4ed8", tooltip="Vertex 6; BFS distance 2; defined in graph.txt"];

  { rank=same; n1; }
  { rank=same; n2 n3; }
  { rank=same; n4 n6; }
  { rank=same; n5; }

  // Blue edges form one deterministic BFS discovery tree.
  n1 -> n2 [color="#2563eb", penwidth=2.2, arrowsize=0.7, tooltip="1 -> 2; weight 10", label="10", fontsize=9, fontname="Arial", fontcolor="#374151"];
  n1 -> n3 [color="#2563eb", penwidth=2.2, arrowsize=0.7, tooltip="1 -> 3; weight 1", label="1", fontsize=9, fontname="Arial", fontcolor="#374151"];
  n2 -> n6 [color="#2563eb", penwidth=2.2, arrowsize=0.7, tooltip="2 -> 6; weight 1", label="1", fontsize=9, fontname="Arial", fontcolor="#374151"];
  n3 -> n4 [color="#2563eb", penwidth=2.2, arrowsize=0.7, tooltip="3 -> 4; weight 1", label="1", fontsize=9, fontname="Arial", fontcolor="#374151"];
  n4 -> n5 [color="#2563eb", penwidth=2.2, arrowsize=0.7, tooltip="4 -> 5; weight 1", label="1", fontsize=9, fontname="Arial", fontcolor="#374151"];
  n5 -> n6 [color="#9ca3af80", penwidth=0.7, arrowsize=0.5, constraint=false, tooltip="5 -> 6; weight 1", label="1", fontsize=9, fontname="Arial", fontcolor="#374151"];
}
